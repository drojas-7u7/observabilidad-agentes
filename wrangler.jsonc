// Configuración de publicación en Cloudflare Workers.
// La web es estática: Cloudflare sirve los archivos que genera "npm run build" en dist/.
{
  "name": "observabilidad-agentes",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": false
}
